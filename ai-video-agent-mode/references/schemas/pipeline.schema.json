        "functional_surface": {"type": "string", "minLength": 1},
        "user": {"type": "string", "minLength": 1},
        "user_view_relation": {"type": "string", "minLength": 2},
        "camera_half_space": {"type": "string", "minLength": 2},
        "camera_visible_surface": {"type": "string", "minLength": 2},
        "grip_contact": {"type": "string", "minLength": 2},
        "interaction_evidence": {"type": "string", "minLength": 2},
        "content_visibility": {"type": "string", "enum": ["hidden", "partial", "readable", "post_overlay", "not_applicable"]},
        "orientation_lock": {"type": "string", "minLength": 2},
        "fallback_shot": {"type": "string", "minLength": 2}
      },
      "required": [
        "applicable", "prop", "functional_surface", "user", "user_view_relation",
        "camera_half_space", "camera_visible_surface", "grip_contact", "interaction_evidence",
        "content_visibility", "orientation_lock", "fallback_shot"
      ],
      "additionalProperties": false
    },
    "skin_tone_protection_contract": {
      "type": "object",
      "properties": {
        "applicable": {"type": "boolean"},
        "subjects": {"type": "string", "minLength": 2},
        "protection_mode": {"type": "string", "enum": ["natural_protected", "motivated_color_cast", "source_authorized_marks", "silhouette"]},
        "source_allowed_skin_marks": {"type": "string", "minLength": 2},
        "skin_tone_baseline": {"type": "string", "minLength": 2},
        "face_light_and_exposure": {"type": "string", "minLength": 2},
        "face_fill_shadow_policy": {"type": "string", "minLength": 2},
        "environment_color_boundary": {"type": "string", "minLength": 2},
        "texture_atmosphere_boundary": {"type": "string", "minLength": 2},
        "continuity_lock": {"type": "string", "minLength": 2},
        "fallback": {"type": "string", "minLength": 2}
      },
      "required": [
        "applicable", "subjects", "protection_mode", "source_allowed_skin_marks",
        "skin_tone_baseline", "face_light_and_exposure", "face_fill_shadow_policy",
        "environment_color_boundary", "texture_atmosphere_boundary", "continuity_lock", "fallback"
      ],
