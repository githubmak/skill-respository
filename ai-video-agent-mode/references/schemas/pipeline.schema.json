        "body_ratio_lock": {"type": "string", "minLength": 2},
        "motion_scaling": {"type": "string", "minLength": 2},
        "prop_scale_lock": {"type": "string", "minLength": 2},
        "grounding_evidence": {"type": "string", "minLength": 2},
        "fallback": {"type": "string", "minLength": 2}
      },
      "required": ["subjects_depth", "support_plane", "projection_scale_rule", "body_ratio_lock", "motion_scaling", "prop_scale_lock", "grounding_evidence", "fallback"],
