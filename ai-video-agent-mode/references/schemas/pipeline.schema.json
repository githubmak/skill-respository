{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Video Agent Mode Mechanical Envelopes",
  "description": "Engineering-owned transport shapes only. Creative content is intentionally open and model-authored.",
  "definitions": {
    "shot_plan": {
      "type": "object",
      "properties": {
        "project_name": {"type": "string"},
        "total_shots": {"type": "integer", "minimum": 1},
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/shot"}
        },
        "dialogue_events": {"type": "object"}
      },
      "required": ["shots"],
      "additionalProperties": true
    },
    "shot": {
      "type": "object",
      "properties": {
        "shot_id": {"type": "string", "minLength": 1},
        "scene": {"type": "string"},
        "total_duration": {"type": "number", "exclusiveMinimum": 0},
        "subshots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/subshot"}
        }
      },
      "required": ["shot_id", "subshots"],
      "additionalProperties": true
    },
    "subshot": {
      "type": "object",
      "properties": {
        "subshot_id": {"type": "string", "minLength": 1},
        "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 15},
        "dialogue_refs": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["subshot_id", "duration"],
      "additionalProperties": true
    },
    "scene_lock_package": {
      "type": "object",
      "properties": {
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/scene_lock"}
        }
      },
      "required": ["scenes"],
      "additionalProperties": false
    },
    "scene_lock": {
      "type": "object",
      "properties": {
        "scene": {"type": "string", "minLength": 1},
        "space_id": {"type": "string", "minLength": 1}
      },
      "required": ["scene", "space_id"],
      "minProperties": 3,
      "additionalProperties": true
    },
    "prompt_package": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "minLength": 1,
          "description": "Exact value is enforced by scripts/contract_registry.py."
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/prompt_item"}
        }
      },
      "required": ["contract_version", "shots"],
      "additionalProperties": false
    },
    "prompt_item": {
      "type": "object",
      "properties": {
        "shot_id": {"type": "string", "minLength": 1},
        "subshot_id": {"type": "string", "minLength": 1},
        "source_subshot_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 15},
        "full_prompt": {"type": "string", "minLength": 1},
        "seedance_prompt": {"type": "string"},
        "seedance_prompt_variants": {
          "type": "object",
          "properties": {
            "2.0": {"type": "string"},
            "2.5": {"type": "string"}
          },
          "additionalProperties": false
        },
        "director_card": {"type": "string", "minLength": 1},
        "negative_prompt": {"type": "string", "minLength": 1},
        "qa_metadata": {
          "type": "object",
          "description": "Model-owned creative analysis. Engineering validates only dialogue facts.",
          "properties": {
            "dialogue_refs": {
              "type": "array",
              "items": {"type": "string"}
            },
            "dialogue_events": {
              "type": "array",
              "items": {"$ref": "#/definitions/dialogue_event"}
            }
          },
          "required": ["dialogue_refs", "dialogue_events"],
          "additionalProperties": true
        },
        "generation_control": {"$ref": "#/definitions/generation_control"}
      },
      "required": [
        "shot_id",
        "subshot_id",
        "source_subshot_ids",
        "duration",
        "full_prompt",
        "seedance_prompt",
        "director_card",
        "negative_prompt",
        "qa_metadata",
        "generation_control"
      ],
      "additionalProperties": true
    },
    "dialogue_event": {
      "type": "object",
      "properties": {
        "ref": {"type": "string"},
        "kind": {"type": "string"},
        "speaker": {"type": "string"},
        "text": {"type": "string"}
      },
      "required": ["ref", "kind", "speaker", "text"],
      "additionalProperties": true
    },
    "generation_control": {
      "type": "object",
      "properties": {
        "mode": {"const": "t2v"},
        "audio_enabled": {"type": "boolean"}
      },
      "required": ["mode", "audio_enabled"],
      "additionalProperties": false
    }
  }
}
